/**
 * Wrangler configuration for x402-iot-poc.
 * Docs: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Week 3 additions:
 *   - durable_objects: DeviceTwin (new_sqlite_classes — required on free plan; new_classes is rejected)
 *   - kv_namespaces: IOT_KV (idempotency keys, receipt log, rate-limit windows)
 *   - vars: DEVICE_ID, TICK_INTERVAL_MS, PRICE_PER_READING, RATE_LIMIT_QUOTA, RATE_LIMIT_WINDOW_S
 *
 * GOTCHA (week 3): Use new_sqlite_classes, not new_classes, for Durable Objects on the free plan.
 * new_classes causes a deploy-time error on accounts without the paid Workers plan.
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "x402-iot-poc",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-13",
  "observability": {
    "enabled": true
  },
  "upload_source_maps": true,
  "compatibility_flags": [
    "nodejs_compat"
  ],

  "vars": {
    "PAY_TO": "0x219ba53AC52D99668a5c20737D1dEd60f435d99E",
    "FACILITATOR_URL": "https://x402.org/facilitator",
    "DEVICE_ID": "sim-sensor-01",
    "TICK_INTERVAL_MS": "60000",
    "PRICE_PER_READING": "$0.001",
    "RATE_LIMIT_QUOTA": "10",
    "RATE_LIMIT_WINDOW_S": "60",
    "USDC_ASSET": "0x036CbD53842c5426634e7929541eC2318f3dCF7e",
    "REQUIRE_MANDATE": "false"
  },

  "durable_objects": {
    "bindings": [
      {
        "name": "DEVICE_TWIN",
        "class_name": "DeviceTwin"
      }
    ]
  },

  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["DeviceTwin"]
    }
  ],

  "kv_namespaces": [
    {
      "binding": "IOT_KV",
      "id": "4ef9455bb906422f984e2eab491236c9"
    }
  ]
}