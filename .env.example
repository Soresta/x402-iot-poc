# .env.example — commit this file; NEVER put real values here.
# Real (testnet) values go in .env — which is gitignored.
#
# ---- Seller (Cloudflare Worker vars) ----
# Set in wrangler.jsonc vars, not in .env (these are non-secret).
# See wrangler.jsonc for: PAY_TO, FACILITATOR_URL, DEVICE_ID,
# TICK_INTERVAL_MS, PRICE_PER_READING, RATE_LIMIT_QUOTA, RATE_LIMIT_WINDOW_S

# ---- Buyer (buyer/pay.mjs and buyer/agent.mjs) ----

# The buyer's testnet private key — ONLY for throwaway testnet wallets.
# NEVER use a key that holds real funds.
BUYER_PRIVATE_KEY=0xYOUR_TESTNET_BUYER_PRIVATE_KEY

# Target resource URL for the single-purchase buyer (buyer/pay.mjs)
RESOURCE_URL=http://127.0.0.1:8787/reading

# ---- Autonomous agent (buyer/agent.mjs) ----

# Base URL of the seller Worker (no trailing slash)
SELLER_URL=http://127.0.0.1:8787

# How often the agent buys (milliseconds). Default: 30000 (30 s)
LOOP_INTERVAL_MS=30000

# Maximum USDC the agent may spend per day. Enforced BEFORE payment.
DAILY_CAP=0.05

# Maximum USDC per single payment call. Must fit within seller's price.
MAX_PER_CALL=0.002

# How long the signed mandate is valid (hours). Default: 24
MANDATE_EXPIRY_HOURS=24

# Kill switch: set to "false" to stop the loop within one iteration.
# Any other value (or absent) means the agent runs normally.
BUYER_ENABLED=true
